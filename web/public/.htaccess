RewriteEngine On

# Единственный канонический вариант: https://ichor.by
RewriteCond %{HTTP_HOST} !^ichor\.by$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://ichor.by%{REQUEST_URI} [R=301,L,NE]

# Служебные, личные и теговые страницы не участвуют в индексации
RewriteRule ^(signin|signup|forgot-password|reset-password|new|edit|myprofile|myposts|settings|admin|chat|discussions|group-chat|tag)(/.*)?$ - [E=NOINDEX:1,L]
Header always set X-Robots-Tag "noindex, follow" env=NOINDEX
